# ============================================================
# LotteryPredictor v4.0 — Environment Variables Example
# Copy to .env and fill with real values. NEVER commit .env.
# ============================================================

# Database (if using Prisma)
DATABASE_URL=

# MCP Server
MCP_PORT=8787
MCP_AUTH_TOKEN=

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Worker Limits
WORKER_TIMEOUT_SECONDS=60
WORKER_MEMORY_LIMIT_MB=512
WORKER_MAX_CONCURRENT=4

# External APIs (all optional — sources are free)
QUICKLOTTO_MCP_URL=https://quicklotto.io/mcp
BETTIP_API_URL=https://bettip.co.za/api/v1

# Logging
LOG_LEVEL=info
# NEVER put secrets here — use environment variables in deployment
